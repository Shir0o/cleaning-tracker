# Copy this file to `.env` and fill in your own values.
# `.env` is gitignored; `.env.example` is committed as a template.
#
# The Web OAuth Client ID from Google Cloud Console
# (APIs & Services -> Credentials -> OAuth 2.0 Client IDs -> Web application).
# Used as `serverClientId` for google_sign_in. See docs/DEVELOPMENT.md.
GOOGLE_SERVER_CLIENT_ID=
